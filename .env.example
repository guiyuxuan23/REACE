# Copy to .env for local work. Keep tokens out of VITE_ variables.
TRACE_ENV=development
TRACE_ENABLE_MOCK=true
TRACE_MOCK_TOKEN=
WEB_PORT=5173
VITE_API_MODE=mock
VITE_API_BASE_URL=http://127.0.0.1:8001
VITE_API_TIMEOUT_MS=10000
